Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Value: true
    # ---------- 纯 GPS：绿色 ----------
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: gps_path
      Pose Style: None
      Topic: /Mower/viz/gps/path
      Value: true
    - Class: rviz/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: gps_odom
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Alpha: 1
        Color: 0; 255; 0
        Head Length: 0.2
        Head Radius: 0.15
        Shaft Length: 0.6
        Shaft Radius: 0.05
        Value: Arrow
      Topic: /Mower/viz/gps/odom
      Value: true
    # ---------- 纯 LIO：蓝色 ----------
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 100; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: lio_path
      Pose Style: None
      Topic: /Mower/viz/lio/path
      Value: true
    - Class: rviz/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: lio_odom
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Alpha: 1
        Color: 0; 100; 255
        Head Length: 0.2
        Head Radius: 0.15
        Shaft Length: 0.6
        Shaft Radius: 0.05
        Value: Arrow
      Topic: /Mower/viz/lio/odom
      Value: true
    # ---------- ceres 融合：红色 ----------
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 0; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: fusion_path
      Pose Style: None
      Topic: /Mower/viz/fusion/path
      Value: true
    - Class: rviz/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: fusion_odom
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Alpha: 1
        Color: 255; 0; 0
        Head Length: 0.2
        Head Radius: 0.15
        Shaft Length: 0.6
        Shaft Radius: 0.05
        Value: Arrow
      Topic: /Mower/viz/fusion/odom
      Value: true
    # ---------- 实际输出：黄色 ----------
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.08
      Name: output_path
      Pose Style: None
      Topic: /Mower/viz/output/path
      Value: true
    - Class: rviz/Odometry
      Covariance:
        Value: false
      Enabled: true
      Keep: 1
      Name: output_odom
      Position Tolerance: 0
      Angle Tolerance: 0
      Shape:
        Alpha: 1
        Color: 255; 255; 0
        Head Length: 0.25
        Head Radius: 0.18
        Shaft Length: 0.7
        Shaft Radius: 0.06
        Value: Arrow
      Topic: /Mower/viz/output/odom
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 40
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.4
      Target Frame: <Fixed Frame>
      Yaw: 0.785
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1400
