<launch>
    <!-- 设置使用真实时间 -->
    <param name="use_sim_time" value="false" />
    <!-- Main node -->   
    <node name="fusion" pkg="fast_lio" type="fast_fusion" output="screen">
        <param name="location_mode"    type="bool"     value="true" />
        <param name="gps_topic"        type="string"   value="/nanobot/gpsposition" />
        <param name="lio_slam_topic"   type="string"   value="/Mower/lio_slam" /> 
        <param name="fusion_topic"     type="string"   value="/Mower/position" />
        <param name="init_threshold"   type="int"      value="30" />
        <param name="map_index"        type="int"      value="0" />
        <param name="map_path"         type="string"   value="../ROS/Lidar/Lidar-SLAM-V2/src/FAST_LIO/Map/my_map.mp" />
    </node>
</launch>
