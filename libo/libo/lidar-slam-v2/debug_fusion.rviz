Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /GPS轨迹1
        - /LIO轨迹1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 1
      Cell Size: 1
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 100
      Reference Frame: <Fixed Frame>
      Value: true

    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        gps_debug:
          Value: true
        lio_debug:
          Value: true
        map:
          Value: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          gps_debug:
            {}
          lio_debug:
            {}
      Update Interval: 0
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 80; 0
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Billboards
      Line Width: 0.05000000074505806
      Name: GPS轨迹
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 180; 0
      Pose Style: Arrows
      Radius: 0.029999999329447746
      Shaft Diameter: 0.15000000596046448
      Shaft Length: 0.20000000298023224
      Topic: /Mower/debug/gps_path
      Unreliable: false
      Value: true

    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 0; 170; 255
      Enabled: true
      Head Diameter: 0.30000001192092896
      Head Length: 0.20000000298023224
      Length: 0.30000001192092896
      Line Style: Billboards
      Line Width: 0.05000000074505806
      Name: LIO轨迹
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 100; 220; 255
      Pose Style: Arrows
      Radius: 0.029999999329447746
      Shaft Diameter: 0.15000000596046448
      Shaft Length: 0.20000000298023224
      Topic: /Mower/debug/lio_path
      Unreliable: false
      Value: true

    - Class: rviz/Axes
      Enabled: true
      Length: 1
      Name: map原点
      Radius: 0.05000000074505806
      Reference Frame: map
      Value: true

  Enabled: true
  Global Options:
    Background Color: 30; 30; 30
    Default Light: true
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Scale: 20
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz)
      X: 0
      Y: 0
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
  X: 100
  Y: 50
  Views:
    collapsed: false
