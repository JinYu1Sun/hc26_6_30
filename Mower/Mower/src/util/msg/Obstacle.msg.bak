Header header

uint32 id
string label

# 2D obb
float64 center_x # m, in localpose
float64 center_y # m, in localpose
float64 width # m
float64 length # m, in heading direction
float64 heading_angle # rad, in localpose, 0=OX, pi/2=OY

float64 v_x # m/s, in localpose
float64 v_y # m/s, in localpose

int32 track_state # 0=undefined; 1=NEW_TARGET; 2=UPDATED_TARGET; 3=COASTED_TARGET
