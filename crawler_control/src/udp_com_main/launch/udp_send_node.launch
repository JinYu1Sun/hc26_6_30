<launch>
    <!-- 启动UDP车辆发送器 -->
    <node pkg="udp_com" type="udp_sender_node" name="udp_sender_node" output="screen">
        <!-- 本地绑定地址 -->
        <param name="local_address" value="192.168.1.101"/>
        <!-- 远程目标地址 -->
        <param name="remote_address" value="192.168.1.30"/>
        <!-- 本地端口 -->
        <param name="local_port" value="8888"/>
        <!-- 远程端口 -->
        <param name="remote_port" value="8888"/>
        <!-- 是否使用多播 -->
        <param name="use_multicast" value="false"/>
        <!-- 是否发送测试帧 -->
        <param name="send_test_frame" value="false"/>
    </node>
</launch>