<!-- launch/udp_vehicle_sender.launch -->
<launch>
    <!-- 启动UDP Com Nodelet -->
    <node pkg="nodelet" type="nodelet" name="udp_com_manager" 
          args="manager" output="screen"/>
    
    <node pkg="nodelet" type="nodelet" name="udp_com_nodelet"
          args="load udp_com/UdpComNodelet udp_com_manager" output="screen"/>
    
    <!-- 启动UDP车辆发送器 -->
    <node pkg="your_package_name" type="udp_vehicle_sender" name="udp_vehicle_sender" output="screen">
        <!-- 本地绑定地址 -->
        <param name="local_address" value="0.0.0.0"/>
        <!-- 远程目标地址 -->
        <param name="remote_address" value="192.168.1.100"/>
        <!-- 本地端口 -->
        <param name="local_port" value="8888"/>
        <!-- 远程端口 -->
        <param name="remote_port" value="8888"/>
        <!-- 是否使用多播 -->
        <param name="use_multicast" value="false"/>
        <!-- 是否发送测试帧 -->
        <param name="send_test_frame" value="false"/>
    </node>
</launch>