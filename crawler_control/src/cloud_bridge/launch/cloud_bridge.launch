<launch>
  <node pkg="cloud_bridge" type="cloud_bridge_node" name="cloud_bridge" output="screen">

    <!-- ===== MQTT broker（明文 TCP，无加密无认证）===== -->
    <param name="broker_host" value="127.0.0.1"/>   <!-- 云平台 MQTT broker 地址 -->
    <param name="broker_port" value="1884"/>
    <param name="client_id" value="cloud_bridge_mower_001"/>
    <param name="username" value=""/>               <!-- 留空 = 不使用用户名密码 -->
    <param name="password" value=""/>
    <param name="keep_alive_interval" value="30"/>
    <param name="connect_timeout" value="5"/>

    <!-- ===== 设备与主题：mower/{device_id}/... ===== -->
    <param name="device_id" value="mower_001"/>
    <param name="topic_prefix" value="mower"/>

    <!-- ===== 上行频率 ===== -->
    <param name="location_hz" value="10.0"/>         <!-- 定位上报频率（开机即上报） -->
    <param name="status_hz" value="20.0"/>           <!-- 车辆状态上报频率 -->

    <!-- ===== 遥控 ===== -->
    <param name="cmd_timeout" value="0.5"/>         <!-- 移动指令看门狗超时（秒），超时自动停车 -->
    <param name="drive_max" value="15000"/>         <!-- linear=1.0 对应的 drive_value -->
    <param name="turn_max" value="12566"/>          <!-- angular=1.0 对应的 turn_value 绝对值 -->
    <param name="auto_pause_on_manual" value="true"/> <!-- 自动任务中收到遥控指令时先 pause -->

    <!-- ===== 自动任务 ===== -->
    <param name="task_step_delay" value="0.5"/>     <!-- start 流程中各 /signal 的间隔（秒） -->
    <param name="task_stop_delay" value="2.0"/>     <!-- stop 后延时发 stop_execution（秒） -->

    <!-- ===== 刀盘 ===== -->
    <param name="mow_height" value="11"/>            <!-- 默认割草高度档位 2~11 -->
  </node>
</launch>
